{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palmgrass-b2b",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "palmgrass-b2b"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://100tiki.com",
    "NEXT_PUBLIC_WHATSAPP_NUMBER": "8617843803954",
    "CONTACT_EMAIL": "sales@palmgrasspro.com",
    "INQUIRY_TO_EMAIL": "sales@palmgrasspro.com"
  }
}
